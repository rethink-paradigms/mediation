    "openworkflow": "^0.9.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "prime-agent": "file:/opt/homebrew/lib/node_modules/prime-agent"
  },
  "engines": {
    "node": ">=22"
  }
