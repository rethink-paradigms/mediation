{
  "name": "@company/mediation",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Agent Presence mediation layer — one factory, EnginePort + RuntimePort",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
    "test:runtime": "node --experimental-strip-types --test 'test/runtime/**/*.test.ts'",
    "test:live-pi": "MEDIATION_LIVE_PI=1 node --experimental-strip-types --test test/pi/live-pi.test.ts test/integration/live-pi-factory.test.ts test/runtime/live-engagement-leaf-pi.test.ts test/runtime/live-ow-worker-pi.test.ts",
    "gauges": "node --experimental-strip-types scripts/gauges/run.ts",
    "gauge:pack-plan": "node --experimental-strip-types scripts/gauges/pack-plan.ts",
    "gauge:imports": "node --experimental-strip-types scripts/gauges/layer-imports.ts",
    "gauge:doors": "node --experimental-strip-types scripts/gauges/second-door.ts",
    "check": "npm run typecheck && npm run test && npm run gauges",
    "mediation": "node --experimental-strip-types src/surfaces/cli.ts",
    "cli": "node --experimental-strip-types src/surfaces/cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "openworkflow": "^0.9.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
