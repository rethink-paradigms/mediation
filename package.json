{
  "name": "@company/mediation",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint -c oxlint.json",
    "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
    "test:runtime": "node --experimental-strip-types --test 'test/runtime/**/*.test.ts'",
    "test:live-pi": "MEDIATION_LIVE_PI=1 node --experimental-strip-types --test test/pi/live-pi.test.ts test/integration/live-pi-factory.test.ts test/runtime/live-engagement-leaf-pi.test.ts test/runtime/live-ow-worker-pi.test.ts test/runtime/live-life-health.test.ts",
    "gauges": "node --experimental-strip-types scripts/gauges/run.ts",
    "gauge:pack-plan": "node --experimental-strip-types scripts/gauges/pack-plan.ts",
    "gauge:imports": "node --experimental-strip-types scripts/gauges/layer-imports.ts",
    "gauge:doors": "node --experimental-strip-types scripts/gauges/second-door.ts",
    "gauge:exports": "node --experimental-strip-types scripts/gauges/export-integrity.ts",
    "check": "tsgo --noEmit && npm run lint && npm run test && npm run gauges",
    "mediation": "node --experimental-strip-types src/surfaces/cli.ts",
    "cli": "node --experimental-strip-types src/surfaces/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.74.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "dependencies": {
    "@earendil-works/agent": "0.0.8",
    "@earendil-works/openworkflow": "0.0.4",
    "@earendil-works/one-mcp": "0.0.6",
    "better-sqlite3": "^11.0.0"
  }
}
